---
import { FAQ } from '../data/content';
---
<section id="faq" class="sec">
  <header class="sec__head">
    <span class="mono" data-reveal>(05) · Dúvidas</span>
    <h2 data-reveal>Perguntas <em>frequentes</em></h2>
  </header>
  <div class="faq" data-reveal>
    {FAQ.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

---
import { wa, MSG } from '../data/site';
import WaIcon from './WaIcon.astro';
import { GMN } from '../data/gmn';

// Soma das visualizações de cada perfil (cada um no seu período, como aparece nos cartões)
const totalViews = GMN.reduce((t, g) => t + Number(g.stats[0].n.replace(/\./g, '')), 0).toLocaleString('pt-BR');
---
<section id="inicio" class="hero">
  <div class="hero__bg" aria-hidden="true">
    <video id="heroVideo" autoplay muted loop playsinline preload="auto" poster="/hero/hero.jpg">
      <source src="/hero/hero.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="hero__inner">
    <p class="pill"><b>Portfólio</b> Sites e resultados no Google · 2026</p>
    <p class="eyebrow">Samuel Andrei · desenvolvedor</p>
    <h1 class="hero__title">
      <span class="hero__line"><span>Crio sites e deixo</span></span>
      <span class="hero__line"><span class="serif">empresas fáceis de <em>achar.</em></span></span>
    </h1>
    <p class="hero__lead">
      Estes são os sites que criei e os números reais dos perfis dessas empresas no Google.
    </p>
    <div class="hero__actions">
      <a class="btn btn--gold" href="#projetos">Ver projetos</a>
      <a class="btn btn--ghost" href={wa(MSG.hero)} target="_blank" rel="noopener noreferrer"><WaIcon />Falar no WhatsApp</a>
    </div>
  </div>

  <ul class="proof">
    <li><b>25+</b><span>sites em produção</span></li>
    <li><b>{totalViews}</b><span>visualizações somadas dos perfis de {GMN.length} clientes no Google (cada um no seu período)</span></li>
    <li><b>4,6★</b><span>nota do Chaveiro Estrela no Google, em 66 avaliações</span></li>
  </ul>
</section>

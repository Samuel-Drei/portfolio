---
import { SITES } from '../data/sites';
import { wa, MSG } from '../data/site';
---
<section id="projetos" class="work" aria-labelledby="work-title">
  <div class="work__sticky">
    <div class="work__track">
      <div class="wpanel wpanel--intro">
        <div class="wintro">
          <h2 id="work-title">Sites no ar<br />&amp; seus resultados</h2>
          <a class="wbtn" href="#google-meu-negocio"><span>Ver resultados no Google</span><i aria-hidden="true">→</i></a>
        </div>
      </div>

      {SITES.map((s) => (
        <article class="wpanel wcard">
          <span class="wline" aria-hidden="true"></span>
          <div class="wcard__inner">
            <a class="wcard__media" href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`Abrir o site ${s.name}`}>
              <video
                muted loop playsinline preload="none"
                poster={`/videos/${s.video}.jpg`}
                data-src={`/videos/${s.video}.mp4`}
                aria-hidden="true"
              ></video>
            </a>
            <div class="wcard__body">
              <h3>{s.name}</h3>
              <div class="wcard__row">
                <div class="wcard__txt">
                  <p>{s.note}</p>
                  {s.result && (
                    <p class="wcard__res"><b>{s.result.n}</b> {s.result.text} <small>· {s.result.period}</small></p>
                  )}
                </div>
                <div class="wcard__links">
                  <a class="wbtn" href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`Visitar o site ${s.name}`}><span>Visitar site</span><i aria-hidden="true">→</i></a>
                  {s.demo && <a class="wbtn wbtn--sm" href={s.demo} target="_blank" rel="noopener noreferrer"><span>Testar demo</span><i aria-hidden="true">→</i></a>}
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}

      <div class="wpanel wpanel--end">
        <span class="wline" aria-hidden="true"></span>
        <div class="wintro">
          <h3>Quer um site assim para o seu negócio?</h3>
          <a class="wbtn" href={wa(MSG.final)} target="_blank" rel="noopener noreferrer"><span>Falar no WhatsApp</span><i aria-hidden="true">→</i></a>
        </div>
        <span class="wend" aria-hidden="true"><span class="wend__line"></span><svg class="wend__plus" width="13" height="13" viewBox="0 0 13 13" fill="none"><line x1="6.5" y1="0" x2="6.5" y2="13" stroke="#2F323B"/><line x1="0" y1="6.5" x2="13" y2="6.5" stroke="#2F323B"/></svg></span>
      </div>
    </div>
  </div>
</section>

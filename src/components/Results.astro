---
import { SITES } from '../data/sites';
import { wa, MSG } from '../data/site';
---
<section id="sites" class="sec sec--alt">
  <header class="sec__head">
    <span class="mono" data-reveal>(02) · Sites no ar</span>
    <h2 data-reveal>Sites que eu <em>criei</em>, funcionando agora</h2>
    <p class="sec__intro" data-reveal>Toque em um cartão para abrir o site de verdade. O vídeo mostra a rolagem da página.</p>
  </header>

  <ul class="sites__grid">
    {SITES.map((s) => (
      <li class="site-card">
        <div class="site-card__media">
          <video
            muted loop playsinline preload="none"
            data-poster={`/videos/${s.video}.jpg`}
            data-src={`/videos/${s.video}.mp4`}
            aria-label={`Rolagem do site ${s.name}`}
          ></video>
        </div>
        <div class="site-card__info">
          <strong>
            {s.url
              ? <a class="site-card__main" href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a>
              : s.name}
          </strong>
          <span>{s.note}</span>
          {(s.url || s.demo) && (
            <div class="site-card__links">
              {s.url && <span class="mono">Ver site ↗</span>}
              {s.demo && <a class="mono" href={s.demo} target="_blank" rel="noopener noreferrer">Testar demo ↗</a>}
            </div>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>

<aside class="strip">
  <p>Quer um site assim para o seu negócio?</p>
  <a class="btn" href={wa(MSG.sites)} target="_blank" rel="noopener noreferrer">Pedir orçamento&nbsp;↗</a>
</aside>

---
import { SITES } from '../data/sites';
import { wa, MSG } from '../data/site';
const HOME = SITES.filter((s) => s.home);
---
<section id="projetos" class="work" aria-labelledby="work-title">
  <div class="work__sticky">
    <div class="work__track">
      <div class="wpanel wpanel--intro">
        <div class="wintro">
          <h2 id="work-title" data-blur>Sites no ar <br />&amp; seus resultados</h2>
          <a class="wbtn" href="#google-meu-negocio"><span>Ver resultados no Google</span><i aria-hidden="true">→</i></a>
        </div>
      </div>

      {HOME.map((s, i) => (
        <article class="wpanel wcard">
          <span class="wline" aria-hidden="true"></span>
          {i === 0 && <svg class="wplus" width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><line x1="6.5" y1="0" x2="6.5" y2="13" stroke="#F4F5F7"/><line x1="0" y1="6.5" x2="13" y2="6.5" stroke="#F4F5F7"/></svg>}
          <div class="wcard__inner">
            <a class="wcard__media" href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`Abrir o site ${s.name}`}>
              <video
                muted loop playsinline preload="none"
                poster={`/videos/${s.video}.jpg`}
                data-src={`/videos/${s.video}.mp4`}
                aria-hidden="true"
              ></video>
            </a>
            <div class="wcard__body">
              <h3>{s.name}</h3>
              <div class="wcard__row">
                <div class="wcard__txt">
                  <p>{s.note}</p>
                  {s.result && (
                    <p class="wcard__res"><b>{s.result.n}</b> {s.result.text} <small>· {s.result.period}</small></p>
                  )}
                </div>
                <div class="wcard__links">
                  <a class="wbtn" href={s.url} target="_blank" rel="noopener noreferrer" aria-label={`Visitar o site ${s.name}`}><span>Visitar site</span><i aria-hidden="true">→</i></a>
                  {s.demo && <a class="wbtn wbtn--sm" href={s.demo} target="_blank" rel="noopener noreferrer"><span>Testar demo</span><i aria-hidden="true">→</i></a>}
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}

      <div class="wpanel wpanel--end">
        <span class="wline" aria-hidden="true"></span>
        <div class="wintro">
          <h3 data-blur>Veja a coleção completa de sites que criei.</h3>
          <a class="wbtn" href="/projetos"><span>Ver todos os projetos</span><i aria-hidden="true">→</i></a>
        </div>
        <span class="wend" aria-hidden="true"><span class="wend__line"></span><svg class="wend__plus" width="13" height="13" viewBox="0 0 13 13" fill="none"><line x1="6.5" y1="0" x2="6.5" y2="13" stroke="#F4F5F7"/><line x1="0" y1="6.5" x2="13" y2="6.5" stroke="#F4F5F7"/></svg></span>
      </div>
    </div>

    <!-- Camada de trás: aparece quando o último painel sai para a esquerda (como uma cortina) -->
    <div class="work__under">
      <p class="work__eyebrow">Fale comigo</p>
      <h2 class="work__big" data-blur="manual">Quer um site <br />assim para o <br />seu negócio?</h2>
      <p class="work__sig"><span aria-hidden="true">✦</span> Site com intenção. Feito para funcionar.</p>
      <a class="wbtn work__cta" href={wa(MSG.final)} target="_blank" rel="noopener noreferrer"><span>Falar no WhatsApp</span><i aria-hidden="true">→</i></a>
    </div>
  </div>
</section>

---
import { SITES } from '../data/sites';
---
<section id="projetos" class="sec">
  <header class="sec__head">
    <p class="eyebrow eyebrow--gold" data-reveal>Projetos</p>
    <h2 data-reveal>Sites no ar e os resultados deles no Google</h2>
  </header>

  <ul class="projects">
    {SITES.map((s, i) => (
      <li class="project" data-reveal>
        <div class="project__media">
          <video
            muted loop playsinline preload="none"
            data-poster={`/videos/${s.video}.jpg`}
            data-src={`/videos/${s.video}.mp4`}
            aria-label={`Rolagem do site ${s.name}`}
          ></video>
        </div>
        <div class="project__head">
          <span class="project__n">{String(i + 1).padStart(2, '0')}</span>
          <h3>
            {s.url
              ? <a class="project__link" href={s.url} target="_blank" rel="noopener noreferrer">{s.name} <span aria-hidden="true">↗</span></a>
              : s.name}
          </h3>
        </div>
        <p class="project__note">{s.note}</p>
        {s.result && (
          <p class="project__result">
            <b>{s.result.n}</b>
            <span>{s.result.text} <small>· {s.result.period}</small></span>
          </p>
        )}
        <div class="project__foot">
          <div class="tags">{s.tags.map((t) => <span>{t}</span>)}</div>
          {s.demo && <a class="project__demo" href={s.demo} target="_blank" rel="noopener noreferrer">Testar demo ↗</a>}
        </div>
      </li>
    ))}
  </ul>
</section>

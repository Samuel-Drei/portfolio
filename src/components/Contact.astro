---
import { wa, MSG, EMAIL, PHONE_LABEL, PHONE_TEL, LINKEDIN, GITHUB, INSTAGRAM } from '../data/site';
---
<section id="contato" class="final">
  <video class="final__video" muted loop playsinline preload="none" poster="/cta/cta.jpg" data-cta aria-hidden="true"><source src="/cta/cta.mp4" type="video/mp4" /></video>
  <div class="final__shade" aria-hidden="true"></div>
  <div class="final__inner">
    <h2 data-reveal>
      <span class="final__l1">Quer um site</span>
      <span class="final__l2">assim para o seu negócio?</span>
    </h2>
    <div data-reveal>
      <a class="gbtn" href={wa(MSG.final)} target="_blank" rel="noopener noreferrer">Falar no WhatsApp</a>
    </div>
    <p class="final__mail" data-reveal>Ou por e-mail: <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>

    <footer class="footer" style="width:100%">
      <div class="footer__cols">
        <div>
          <h3>Contato</h3>
          <a href={`tel:${PHONE_TEL}`}>{PHONE_LABEL}</a>
          <a href={`mailto:${EMAIL}`}>E-mail</a>
        </div>
        <div>
          <h3>Redes</h3>
          {INSTAGRAM && <a href={INSTAGRAM} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}
          <a href={LINKEDIN} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a href={GITHUB} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
        <div>
          <h3>Mais</h3>
          <a href="/assets/curriculo-samuel-andrei.pdf" download>Currículo (PDF)</a>
          <a href="#projetos">Projetos</a>
          <a href="#google-meu-negocio">Resultados no Google</a>
        </div>
      </div>
      <div class="footer__base">
        <span>© 2026 Samuel Andrei Tramontin Teixeira</span>
        <a href="#inicio">Voltar ao topo ↑</a>
      </div>
    </footer>
  </div>
</section>
